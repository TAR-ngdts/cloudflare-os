{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["./worker-configuration.d.ts"],
    "paths": {
      "@gadgets/workshop-shared/*": ["../workshop-shared/src/*"]
    }
  },
  "include": ["src", "__tests__"],
  // The opt-in local end-to-end test needs Node types the Worker build deliberately does not load; vitest still runs it.
  "exclude": ["dist", "node_modules", "__tests__/local-e2e.test.ts"]
}
